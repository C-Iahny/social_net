{
  "appId": "com.vazimba.io",
  "appName": "Vazimba",
  "webDir": "www",
  "server": {
    "url": "https://www.vazimba.io",
    "cleartext": false,
    "androidScheme": "https",
    "iosScheme": "https",
    "allowNavigation": [
      "www.vazimba.io",
      "vazimba.io"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#f4f6f8",
    "overrideUserAgent": "VazimbaApp/1.1 Android"
  },
  "ios": {
    "contentInset": "automatic",
    "backgroundColor": "#f4f6f8",
    "overrideUserAgent": "VazimbaApp/1.1 iOS"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#f4f6f8",
      "showSpinner": false,
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP"
    }
  }
}
